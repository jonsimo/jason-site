---
import { services } from '../data/site';
import Icon from './Icon.astro';
---
<section class="border-y border-border bg-card">
  <div class="container-x py-20 md:py-28">
    <p class="eyebrow eyebrow-line mb-12" data-reveal="fade"><span class="text-foreground/50">02</span> Services</p>
    <ul class="grid grid-cols-1 gap-12 md:grid-cols-3 md:gap-10">
      {services.map((s, i) => (
        <li class="group relative pt-8" data-reveal style={`--d:${i * 150}ms`}>
          <span class="absolute left-0 top-0 h-px w-full bg-border"></span>
          <span class="absolute left-0 top-0 h-px w-full origin-left scale-x-0 bg-primary transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:scale-x-100"></span>
          <div class="mb-6 flex items-center justify-between">
            <Icon name={s.icon} size={30} class="text-primary" />
            <span class="font-heading text-sm italic text-muted-foreground">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <h3 class="mb-3 font-heading text-2xl text-foreground">{s.title}</h3>
          <p class="text-sm leading-relaxed text-muted-foreground">{s.description}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
