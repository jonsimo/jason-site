---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Clients from '../components/Clients.astro';
import CTA from '../components/CTA.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Lightbox from '../components/Lightbox.astro';
import Icon from '../components/Icon.astro';
import { projects } from '../data/site';
import { url } from '../lib/url';
import { getHeroSources, heroSizes } from '../lib/heroImage';

// Editorial layout: portrait/square pieces sit three-up at 3:4,
// anything panoramic runs full-width at its native cinematic ratio.
const isWide = (p: (typeof projects)[number]) => p.image.width / p.image.height > 1.4;
const featured = projects.filter((p) => p.featured).sort((a, b) => Number(isWide(a)) - Number(isWide(b)));
const { avif } = await getHeroSources();
---
<Base preloadImage={{ src: avif.src, srcset: avif.srcSet.attribute, sizes: heroSizes, type: 'image/avif' }}>
  <Hero />

  <section class="container-x py-24 md:py-32">
    <div class="mb-14 flex items-end justify-between" data-reveal="fade">
      <div>
        <p class="eyebrow eyebrow-line mb-4"><span class="text-foreground/50">01</span> Selected Works</p>
        <h2 class="font-heading text-4xl text-foreground md:text-6xl">Featured <span class="italic">Projects</span></h2>
      </div>
      <a href={url('/portfolio/')} class="group hidden items-center gap-2 text-sm uppercase tracking-wider text-muted-foreground transition-colors hover:text-primary md:inline-flex">
        View All
        <Icon name="arrow-right" size={14} strokeWidth={2} class="transition-transform group-hover:translate-x-1" />
      </a>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {featured.map((p, i) =>
        isWide(p)
          ? <ProjectCard project={p} index={i} number={i + 1} class="md:col-span-3" sizes="(min-width: 1280px) 1200px, 100vw" />
          : <ProjectCard project={p} index={i} number={i + 1} aspect="3/4" class="" sizes="(min-width: 1280px) 400px, (min-width: 768px) 33vw, 100vw" />
      )}
    </div>

    <a href={url('/portfolio/')} class="group mt-10 inline-flex items-center gap-2 text-sm uppercase tracking-wider text-muted-foreground transition-colors hover:text-primary md:hidden">
      View All Projects
      <Icon name="arrow-right" size={14} strokeWidth={2} class="transition-transform group-hover:translate-x-1" />
    </a>
  </section>

  <Services />
  <Clients />
  <CTA />
  <Lightbox />
</Base>
