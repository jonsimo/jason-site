---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Lightbox from '../components/Lightbox.astro';
import { projects, categories } from '../data/site';

const filters = ['All', ...categories];
---
<Base title="Portfolio" description="Selected photography, cinematography and creative direction by SightlessVision.">
  <div class="container-x pb-24 pt-32">
    <header class="mb-14 flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="eyebrow eyebrow-line animate-rise mb-4">Portfolio</p>
        <h1 class="font-heading text-5xl text-foreground md:text-7xl">
          <span class="line-mask"><span style="--d:120ms">Body of <span class="italic">Work</span></span></span>
        </h1>
      </div>
      <p class="animate-rise text-xs uppercase tracking-[0.3em] text-muted-foreground" style="--d:300ms"><span class="font-heading text-2xl normal-case tracking-normal text-foreground" data-visible-count>{String(projects.length).padStart(2, '0')}</span>&nbsp; Projects</p>
    </header>

    <div class="animate-rise mb-12 flex flex-wrap gap-3" style="--d:200ms" role="group" aria-label="Filter projects">
      {filters.map((cat, i) => (
        <button
          type="button"
          data-filter={cat}
          aria-pressed={i === 0 ? 'true' : 'false'}
          class="rounded-sm border border-border px-5 py-2.5 text-xs uppercase tracking-widest text-muted-foreground transition-all duration-300 hover:border-foreground/30 hover:text-foreground aria-pressed:border-primary aria-pressed:bg-primary/10 aria-pressed:text-primary"
        >
          {cat}
        </button>
      ))}
    </div>

    <div class="columns-1 gap-6 md:columns-2 lg:columns-3" data-grid>
      {projects.map((p, i) => (
        <ProjectCard project={p} index={i} number={i + 1} eager={i < 3} priority={i === 0} sizes="(min-width: 1280px) 400px, (min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" />
      ))}
    </div>
    <p data-empty hidden class="py-20 text-center text-muted-foreground">Nothing here yet.</p>
  </div>
  <Lightbox />
</Base>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-grid] > figure')];
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const counter = document.querySelector<HTMLElement>('[data-visible-count]')!;

  function apply(cat: string, animate = true) {
    const run = () => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === cat)));
      let shown = 0;
      cards.forEach((c) => {
        const on = cat === 'All' || c.dataset.category === cat;
        c.hidden = !on;
        if (on) { shown++; c.classList.add('is-in'); }
      });
      empty.hidden = shown > 0;
      counter.textContent = String(shown).padStart(2, '0');
    };
    // Smoothly re-flow the grid where the View Transitions API exists
    if (animate && 'startViewTransition' in document && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.startViewTransition(run);
    } else run();
  }

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const cat = b.dataset.filter!;
      apply(cat);
      const u = new URL(location.href);
      cat === 'All' ? u.searchParams.delete('category') : u.searchParams.set('category', cat.toLowerCase().replace(/ /g, '-'));
      history.replaceState(null, '', u);
    }),
  );

  // Deep-linkable filters: /portfolio/?category=cinematography
  const q = new URL(location.href).searchParams.get('category');
  const match = q && buttons.find((b) => b.dataset.filter!.toLowerCase().replace(/ /g, '-') === q);
  if (match) apply(match.dataset.filter!, false);
</script>
