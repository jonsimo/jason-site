---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { Picture } from 'astro:assets';
import { about } from '../data/site';
import { url } from '../lib/url';
import { lqip } from '../lib/lqip';

const placeholder = await lqip(about.portrait);
---
<Base title="About" description="The eye behind the lens — a Toronto-based visual storyteller working across photography, cinematography and creative direction.">
  <div class="pb-24 pt-32">
    <section class="container-x mb-20 md:mb-28">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-20">
        <div>
          <p class="eyebrow eyebrow-line animate-rise mb-5">About</p>
          <h1 class="mb-8 font-heading text-5xl leading-[1.02] text-foreground md:text-7xl">
            <span class="line-mask"><span style="--d:120ms">The eye behind</span></span>
            <span class="line-mask"><span class="italic" style="--d:240ms">the lens</span></span>
          </h1>
          {about.paragraphs.map((p, i) => (
            <p class="animate-rise mb-6 text-base leading-relaxed text-muted-foreground last-of-type:mb-8" style={`--d:${200 + i * 100}ms`}>{p}</p>
          ))}
          <div class="animate-rise flex items-center gap-6 text-sm text-muted-foreground" style="--d:400ms">
            {about.meta.map((m) => <span>{m}</span>)}
          </div>
        </div>

        <div class="animate-rise relative" style="--d:250ms">
          <div class="lqip aspect-[3/4] overflow-hidden rounded-sm bg-secondary" style={placeholder ? `background-image:url(${placeholder})` : undefined}>
            <Picture
              src={about.portrait}
              alt={about.portraitAlt}
              widths={[480, 720, 960, 1280]}
              sizes="(min-width: 1280px) 560px, (min-width: 1024px) 45vw, 100vw"
              formats={['avif', 'webp']}
              quality={72}
              loading="eager"
              fetchpriority="high"
              data-fade
              onload="this.classList.add('is-loaded')"
              class="h-full w-full object-cover"
            />
          </div>
          <div class="absolute -bottom-6 -left-6 hidden rounded-sm border border-border bg-card p-5 lg:block">
            <Icon name="award" size={24} strokeWidth={2} class="mb-2 text-primary" />
            <p class="font-heading text-lg text-foreground">{about.badge.title}</p>
            <p class="text-xs text-muted-foreground">{about.badge.subtitle}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="mb-20 border-y border-border bg-card py-16 md:mb-28" aria-label="By the numbers">
      <dl class="container-x grid grid-cols-2 gap-8 md:grid-cols-4">
        {about.stats.map((s, i) => (
          <div class="flex flex-col-reverse text-center" data-reveal style={`--d:${i * 100}ms`}>
            <dt class="text-xs uppercase tracking-widest text-muted-foreground">{s.label}</dt>
            <dd class="mb-2 font-heading text-4xl tabular-nums text-primary md:text-5xl">
              <span data-count={s.value}>{s.value}</span>{s.suffix}
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="mx-auto mb-20 max-w-3xl px-6 md:mb-28 md:px-10">
      <div class="mb-12" data-reveal="fade">
        <p class="eyebrow eyebrow-line mb-4">Journey</p>
        <h2 class="font-heading text-3xl text-foreground md:text-4xl">The Path So Far</h2>
      </div>
      <ol class="space-y-10">
        {about.timeline.map((t, i) => (
          <li class="flex gap-6" data-reveal style={`--d:${i * 100}ms; --reveal-y: 0px`}>
            <div class="flex flex-col items-center">
              <div class="h-3 w-3 shrink-0 rounded-full bg-primary"></div>
              {i < about.timeline.length - 1 && <div class="mt-2 h-full w-px bg-border"></div>}
            </div>
            <div class="pb-2">
              <p class="mb-1 text-xs uppercase tracking-widest text-primary">{t.year}</p>
              <h3 class="mb-1 font-heading text-lg text-foreground">{t.title}</h3>
              <p class="text-sm text-muted-foreground">{t.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <div class="px-6 text-center">
      <a href={url('/contact/')} class="group inline-flex items-center gap-3 rounded-sm border border-border px-8 py-4 text-sm uppercase tracking-widest text-foreground transition-colors hover:border-primary hover:text-primary">
        Let's Work Together
        <Icon name="arrow-right" size={16} strokeWidth={2} class="transition-transform group-hover:translate-x-1" />
      </a>
    </div>
  </div>
</Base>

<script>
  // Count-up for the stats when they scroll into view (final values are in the HTML for no-JS / SEO).
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const els = document.querySelectorAll<HTMLElement>('[data-count]');
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        io.unobserve(e.target);
        const el = e.target as HTMLElement;
        const end = Number(el.dataset.count);
        const t0 = performance.now();
        const dur = 1600;
        const tick = (t: number) => {
          const p = Math.min(1, (t - t0) / dur);
          el.textContent = String(Math.round(end * (1 - Math.pow(1 - p, 4))));
          if (p < 1) requestAnimationFrame(tick);
        };
        el.textContent = '0';
        requestAnimationFrame(tick);
      }
    }, { threshold: 0.6 });
    els.forEach((el) => io.observe(el));
  }
</script>
