---
import Base from '../layouts/Base.astro';
import AwardCard from '../components/AwardCard.astro';
import Icon from '../components/Icon.astro';
import { awarded, nominated } from '../data/site';

const sections = [
  { id: 'awarded', label: 'Awarded', icon: 'award', items: awarded },
  { id: 'nominated', label: 'Nominated', icon: 'star', items: nominated },
] as const;
---
<Base title="Awards" description="Awards and nominations for SightlessVision's photography, film and creative direction.">
  <div class="container-x pb-24 pt-32">
    <header class="mb-20">
      <p class="eyebrow eyebrow-line animate-rise mb-4">Recognition</p>
      <h1 class="font-heading text-5xl text-foreground md:text-7xl">
        <span class="line-mask"><span style="--d:120ms">Awards <span class="italic text-primary">&amp;</span> Nominations</span></span>
      </h1>
      <p class="animate-rise mt-6 text-xs uppercase tracking-[0.3em] text-muted-foreground" style="--d:300ms">
        <span class="font-heading text-2xl normal-case tracking-normal text-foreground">{String(awarded.length).padStart(2, '0')}</span>&nbsp; Awards
        <span class="mx-4 text-border">/</span>
        <span class="font-heading text-2xl normal-case tracking-normal text-foreground">{String(nominated.length).padStart(2, '0')}</span>&nbsp; Nominations
      </p>
    </header>

    {sections.map((s, si) => (
      <section class:list={[si === 0 && 'mb-20']} aria-labelledby={s.id}>
        <div class="mb-10 flex items-center gap-4" data-reveal="fade">
          <Icon name={s.icon} size={16} strokeWidth={2} class={s.id === 'awarded' ? 'text-primary' : 'text-muted-foreground'} />
          <h2 id={s.id} class="font-heading text-2xl text-foreground md:text-3xl">{s.label}</h2>
          <div class="h-px flex-1 bg-border"></div>
        </div>
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
          {s.items.map((item, i) => <AwardCard item={item} index={i} type={s.id} eager={si === 0 && i < 2} />)}
        </div>
      </section>
    ))}
  </div>
</Base>
